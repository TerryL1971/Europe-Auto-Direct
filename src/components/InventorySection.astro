---
// src/components/InventorySection.astro
import InventoryGrid from './InventoryGrid.tsx';
---

<section id="inventory" class="bg-white/60 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-extrabold tracking-tight text-navy-900 sm:text-4xl" data-i18n="inv.title">
        Inventory preview
      </h2>
      <p class="mt-4 text-lg text-navy-500" data-i18n="inv.sub">
        A sample of EU-spec stock. Every total below already includes German VAT
        at 19%, shown on its own line.
      </p>
    </div>

    <div class="mt-10">
      <InventoryGrid client:visible />
    </div>
  </div>
</section>
