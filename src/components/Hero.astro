---
// src/components/Hero.astro
---

<section id="top" class="relative overflow-hidden bg-navy-900 text-white">
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.14]"
    style="background-image: radial-gradient(circle at 1px 1px, #fff 1px, transparent 0); background-size: 26px 26px;"
    aria-hidden="true"
  >
  </div>
  <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-clear-500/20 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:py-28">
    <div>
      <p
        class="mb-4 inline-flex items-center rounded-full border border-white/20 bg-white/5 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-clear-200"
        data-i18n="hero.eyebrow"
      >
        Stuttgart region · Luxembourg
      </p>

      <h1
        class="max-w-xl text-4xl font-extrabold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl"
        data-i18n="hero.headline"
      >
        Your car. Your country. No complications.
      </h1>

      <p class="mt-6 max-w-lg text-lg leading-relaxed text-navy-100" data-i18n="hero.sub">
        EU-spec vehicles at one honest, VAT-inclusive price. The number you see is
        the number you pay — itemised, in your language, with the paperwork handled.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#inventory"
          class="rounded-full bg-clear-500 px-6 py-3 text-sm font-bold text-navy-900 transition-colors hover:bg-clear-400"
          data-i18n="hero.cta"
        >
          Browse inventory
        </a>
        <a
          href="#price"
          class="rounded-full border border-white/25 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-white/10"
          data-i18n="hero.cta2"
        >
          See a price breakdown
        </a>
      </div>

      <ul class="mt-10 grid gap-3 text-sm text-navy-100 sm:grid-cols-3">
        {[
          { key: 'hero.badge1', label: 'Every price VAT-inclusive' },
          { key: 'hero.badge2', label: 'EU-spec vehicles only' },
          { key: 'hero.badge3', label: 'No surprise costs at signing' },
        ].map((b) => (
          <li class="flex items-start gap-2">
            <svg viewBox="0 0 20 20" class="mt-0.5 h-4 w-4 shrink-0 text-clear-300" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 10.7a1 1 0 1 1 1.4-1.4l3 3 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/>
            </svg>
            <span data-i18n={b.key}>{b.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="relative">
      <div class="rounded-2xl border border-white/15 bg-white/[0.06] p-6 shadow-2xl backdrop-blur">
        <p class="text-xs font-semibold uppercase tracking-wider text-navy-200">
          2022 Volkswagen Golf · 1.5 TSI
        </p>
        <div class="mt-4 space-y-2.5 text-sm">
          <div class="flex items-center justify-between text-navy-100">
            <span data-i18n="price.base">Base price (net)</span>
            <span class="tabular-nums">€18,403</span>
          </div>
          <div class="flex items-center justify-between text-navy-100">
            <span data-i18n="price.vat">VAT (19%)</span>
            <span class="tabular-nums">€3,497</span>
          </div>
          <div class="my-2 border-t border-white/15"></div>
          <div class="flex items-center justify-between text-base font-bold">
            <span data-i18n="price.total">Total price you pay</span>
            <span class="tabular-nums text-clear-300">€21,900</span>
          </div>
        </div>
        <p class="mt-4 text-xs leading-relaxed text-navy-200" data-i18n="price.note">
          Illustrative. Every listing on the site shows this same breakdown for
          its actual price.
        </p>
      </div>
    </div>
  </div>
</section>
