---
// src/components/HowItWorks.astro
const steps = [
  { key: 'how.step1', t: 'Browse', d: 'Every listing shows the full price with VAT already in it, plus mileage, spec and where the car is.' },
  { key: 'how.step2', t: 'Reserve or ask', d: 'Hold a car with a refundable deposit, or send a question first. Replies come in English, German or French.' },
  { key: 'how.step3', t: 'Paperwork support', d: 'We walk you through registration (Zulassung), insurance and the TÜV situation — no German credit history required.' },
  { key: 'how.step4', t: 'Drive away', d: 'Collect near Stuttgart, or have the car delivered anywhere in Germany or Luxembourg. Plates and documents ready on the day.' },
];
---

<section id="how" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div class="max-w-2xl">
    <h2 class="text-3xl font-extrabold tracking-tight text-navy-900 sm:text-4xl" data-i18n="how.title">
      Buying a car in a country you just moved to
    </h2>
    <p class="mt-4 text-lg text-navy-500" data-i18n="how.sub">
      You have not done this here before. That is the normal case, not the
      exception — the process is built around it.
    </p>
  </div>

  <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {steps.map((s, i) => (
      <li class="rounded-card border border-navy-100 bg-white p-6">
        <span class="grid h-10 w-10 place-items-center rounded-full bg-navy-50 text-sm font-extrabold text-navy-700">
          {i + 1}
        </span>
        <h3 class="mt-4 text-lg font-bold text-navy-900" data-i18n={`${s.key}.t`}>{s.t}</h3>
        <p class="mt-2 text-sm leading-relaxed text-navy-500" data-i18n={`${s.key}.d`}>{s.d}</p>
      </li>
    ))}
  </ol>
</section>
