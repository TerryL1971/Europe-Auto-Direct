---
// src/components/LocationsSection.astro
---

<section id="locations" class="bg-white/60 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-3xl font-extrabold tracking-tight text-navy-900 sm:text-4xl" data-i18n="loc.title">
      Where we operate
    </h2>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-card border border-navy-100 bg-white p-7">
        <div class="flex items-center gap-2 text-navy-700">
          <svg viewBox="0 0 20 20" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18s6-5.3 6-10a6 6 0 1 0-12 0c0 4.7 6 10 6 10Zm0-7.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" clip-rule="evenodd"/>
          </svg>
          <h3 class="text-xl font-bold text-navy-900" data-i18n="loc.stuttgart.t">Stuttgart</h3>
          <span class="rounded-full bg-clear-100 px-2 py-0.5 text-[11px] font-semibold text-clear-700">
            Primary
          </span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-navy-500" data-i18n="loc.stuttgart.d">
          Primary location. Viewings, collection and registration support in
          person across the wider region.
        </p>
      </div>

      <div class="rounded-card border border-navy-100 bg-white p-7">
        <div class="flex items-center gap-2 text-navy-700">
          <svg viewBox="0 0 20 20" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18s6-5.3 6-10a6 6 0 1 0-12 0c0 4.7 6 10 6 10Zm0-7.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" clip-rule="evenodd"/>
          </svg>
          <h3 class="text-xl font-bold text-navy-900" data-i18n="loc.lux.t">Luxembourg</h3>
          <span class="rounded-full bg-navy-50 px-2 py-0.5 text-[11px] font-semibold text-navy-600">
            Served market
          </span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-navy-500" data-i18n="loc.lux.d">
          Served market. Remote purchase with delivery and documentation handled
          end to end — no physical branch required.
        </p>
      </div>
    </div>
  </div>
</section>
