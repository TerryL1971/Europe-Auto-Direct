---
// src/components/ContactSection.astro
import ContactForm from './ContactForm.tsx';
---

<section id="contact" class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
  <h2 class="text-3xl font-extrabold tracking-tight text-navy-900 sm:text-4xl" data-i18n="contact.title">
    Ask a question
  </h2>
  <p class="mt-4 text-lg text-navy-500" data-i18n="contact.sub">
    Tell us what you are looking for, or ask about a specific car. No obligation.
  </p>

  <div class="mt-8">
    <ContactForm client:visible />
  </div>
</section>
