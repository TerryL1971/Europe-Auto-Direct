---
// src/pages/inventory/[id].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Gallery from '../../components/Gallery.tsx';
import { inventory, getVehicle } from '../../lib/inventory';
import { money, groupInt } from '../../lib/format';

export function getStaticPaths() {
  return inventory.map((v) => ({ params: { id: v.id } }));
}

const { id } = Astro.params;
const v = getVehicle(id!)!;

const name = `${v.year} ${v.make} ${v.model}`;
const title = `${name} — Europe Auto Direct`;
const description = `${name}, ${v.trim}. ${groupInt(v.mileageKm)} km · ${v.fuel} · ${v.transmission}. ${money(v.priceGross)} incl. VAT, located in ${v.location}.`;

const specs: [string, string, string][] = [
  ['veh.year', 'Year', String(v.year)],
  ['veh.mileage', 'Mileage', `${groupInt(v.mileageKm)} km`],
  ['veh.fuel', 'Fuel', v.fuel],
  ['veh.transmission', 'Transmission', v.transmission],
  ['veh.body', 'Body type', v.bodyType],
  ['veh.trim', 'Trim', v.trim],
  ['veh.location', 'Location', v.location],
];

const Check = `<svg viewBox="0 0 20 20" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-clear-500" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 10.7a1 1 0 1 1 1.4-1.4l3 3 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/></svg>`;
---

<BaseLayout title={title} description={description}>
  <Header />

  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <a
      href="/#inventory"
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-navy-500 transition-colors hover:text-navy-900"
    >
      <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4 6 10l6 6" /></svg>
      <span data-i18n="veh.back">Back to inventory</span>
    </a>

    <div class="mt-6 grid gap-10 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <Gallery images={v.images} alt={name} client:load />

        <section class="mt-8">
          <h2 class="text-lg font-bold text-navy-900" data-i18n="veh.about">About this car</h2>
          <p class="mt-2 leading-relaxed text-navy-500">{v.blurb}</p>
          <p class="mt-3 leading-relaxed text-navy-500" data-i18n="veh.included">
            EU-spec and already road-legal in Germany. We handle the registration
            paperwork, help you sort insurance, and a 12-month mechanical check is
            included.
          </p>
        </section>

        <section class="mt-8">
          <h2 class="text-lg font-bold text-navy-900" data-i18n="veh.specs">Specification</h2>
          <dl class="mt-3 grid gap-x-10 gap-y-1 sm:grid-cols-2">
            {specs.map(([key, label, value]) => (
              <div class="flex items-center justify-between gap-4 border-b border-navy-100 py-2.5">
                <dt class="text-sm text-navy-400" data-i18n={key}>{label}</dt>
                <dd class="text-right text-sm font-semibold text-navy-800">{value}</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-card border border-navy-100 bg-white p-6">
          <p class="text-xs font-semibold uppercase tracking-wide text-navy-400">
            {v.year} {v.make}
          </p>
          <h1 class="mt-1 text-2xl font-extrabold leading-tight text-navy-900">
            {v.model}
          </h1>
          <p class="mt-1 text-sm text-navy-400">{v.trim} · {v.location}</p>

          <div class="mt-5 rounded-xl bg-sand p-4">
            <span class="text-[11px] font-semibold uppercase tracking-wide text-navy-400" data-i18n="inv.total">
              Total price
            </span>
            <div class="mt-0.5 text-3xl font-extrabold tabular-nums text-navy-900">{money(v.priceGross)}</div>
            <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-navy-500">
              <span><span data-i18n="inv.net">Net price</span> {money(v.priceNet)}</span>
              <span class="rounded bg-clear-100 px-1.5 py-0.5 font-semibold text-clear-700">
                + {money(v.vatAmount)} <span data-i18n="inv.vatLine">VAT</span> ({v.vatRate}%)
              </span>
            </div>
            <p class="mt-3 text-[11px] leading-relaxed text-navy-400" data-i18n="veh.vatNote">
              Includes 19% German VAT — the total shown is the total you pay.
            </p>
          </div>

          <a
            href="/#contact"
            class="mt-4 block rounded-full bg-navy-700 px-5 py-3 text-center text-sm font-bold text-white transition-colors hover:bg-navy-800"
            data-i18n="inv.cta"
          >
            Enquire about this car
          </a>

          <ul class="mt-5 space-y-2 text-xs text-navy-500">
            <li class="flex gap-2"><Fragment set:html={Check} /><span data-i18n="veh.euspec">EU-spec — road-legal here, no import steps</span></li>
            <li class="flex gap-2"><Fragment set:html={Check} /><span data-i18n="hero.badge3">No surprise costs at signing</span></li>
            <li class="flex gap-2"><Fragment set:html={Check} /><span data-i18n="why.p4.t">Support in your language</span></li>
          </ul>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</BaseLayout>
